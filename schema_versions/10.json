  "fixed_sql": [
    {
      "name": "tracks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tracks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"uri\" TEXT NOT NULL UNIQUE, \"title\" TEXT NOT NULL, \"artist\" TEXT NULL, \"album\" TEXT NULL, \"duration_ms\" INTEGER NULL, \"track_number\" INTEGER NULL, \"year\" INTEGER NULL, \"file_size\" INTEGER NULL, \"date_added\" INTEGER NOT NULL, \"date_modified\" INTEGER NULL, \"search_text\" TEXT NOT NULL DEFAULT '', \"sort_title\" TEXT NOT NULL DEFAULT '', \"is_available\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_available\" IN (0, 1)), \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"favorited_at\" INTEGER NULL, \"artwork_path\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "playlists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlists\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"custom_artwork_path\" TEXT NULL, \"added_at\" INTEGER NOT NULL DEFAULT (0), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"last_played_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "playlist_tracks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlist_tracks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"playlist_id\" INTEGER NOT NULL REFERENCES playlists (id) ON DELETE CASCADE, \"track_id\" INTEGER NOT NULL REFERENCES tracks (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"added_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "library_folders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"library_folders\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"path\" TEXT NOT NULL UNIQUE, \"added_at\" INTEGER NOT NULL, \"last_scanned_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "playback_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playback_state\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"current_index\" INTEGER NULL, \"position_ms\" INTEGER NOT NULL DEFAULT 0, \"shuffle\" INTEGER NOT NULL DEFAULT 0 CHECK (\"shuffle\" IN (0, 1)), \"repeat_mode\" TEXT NOT NULL DEFAULT 'off', \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "queue_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"queue_items\" (\"position\" INTEGER NOT NULL, \"track_id\" INTEGER NOT NULL REFERENCES tracks (id) ON DELETE CASCADE, \"original_position\" INTEGER NULL, PRIMARY KEY (\"position\"));"
        }
      ]
    },
    {
      "name": "excluded_uris",
      "sql": [
